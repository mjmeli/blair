# Pull this image on your NAS, or replace the tag with a branch/SHA/release tag.
BLAIR_IMAGE=ghcr.io/mjmeli/blair:latest
DISABLE_ANALYTICS=true

# Restrict the sign-in screen to your Nanit account email.
ALLOWED_EMAILS=your-nanit-email@example.com

# Your own AI provider keys. Gemini is only needed for audio analysis.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_DAILY_LIMIT_PER_BABY=40
AI_DAILY_LIMIT_GLOBAL=400
# Text/image provider and model (defaults: anthropic + claude-opus-5; OpenAI defaults to gpt-6-luna).
# BLAIR_AI_PROVIDER=anthropic
# BLAIR_AI_MODEL=claude-opus-5
# BLAIR_AI_EFFORT=medium
# To use OpenAI instead:
# BLAIR_AI_PROVIDER=openai
# BLAIR_AI_MODEL=gpt-6-luna

# Optional administrative and feedback settings.
# ADMIN_KEY=
# RESEND_API_KEY=
# FEEDBACK_TO_EMAIL=
# FEEDBACK_FROM_EMAIL=
